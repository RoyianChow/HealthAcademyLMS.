{
  "name": "healthy-academy-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib hooks tests middleware.ts prisma/seed-test.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --coverage --project unit",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:reset": "DATABASE_URL=postgresql://test:test@localhost:5433/healthacademy_test DIRECT_URL=postgresql://test:test@localhost:5433/healthacademy_test prisma migrate reset --force",
    "test:db:setup": "npm run test:db:up && sleep 2 && npm run test:db:reset",
    "test:e2e": "NODE_OPTIONS='--import tsx' playwright test",
    "test:e2e:ui": "NODE_OPTIONS='--import tsx' playwright test --ui",
    "test:all": "bash scripts/test-all.sh",
    "migrate:wordpress": "tsx --env-file=.env migrate-wordpress.ts",
    "fix:migrated-content": "tsx --env-file=.env fix-migrated-tiptap-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed-test.ts"
  },
